# Copy to .env and fill in. Do not commit .env.

MONGODB_URI=
MONGODB_DB=memplug

# Postgres with pgvector. Required for extraction and search.
DATABASE_URL=

# Model used to turn captured chat into memories.
META_API_KEY=
META_MODEL=

# Signs browser sessions. Leave empty locally to generate .auth_secret.
MEMPLUG_AUTH_SECRET=

# Public base URL embedded in downloaded hooks and the MCP snippet.
# Local example: http://127.0.0.1:8000
# Hosted example: https://memplug-capture-data.onrender.com
MEMPLUG_PUBLIC_API_URL=

# Email codes for sign-in and password reset.
MAIL_FROM=Memplug <memplug@support.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional shared capture key. Console personal and team keys are the normal path.
MEMPLUG_CAPTURE_API_KEY=

# Card checkout. Leave empty until you are ready to charge.
# Webhook endpoint: POST /v1/billing/webhook
# Optional fixed Price ids. Without them the server creates lookup-key prices once.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

CHECKPOINT_TOKENS=1000
CHECKPOINT_IDLE_MINUTES=30
